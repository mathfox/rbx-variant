{
    "compilerOptions": {
        // required
        "noLib": true,
        "strict": true,
        "downlevelIteration": true,
        "forceConsistentCasingInFileNames": true,
        "allowSyntheticDefaultImports": true,
        "module": "CommonJS",
        "moduleResolution": "Node",
        "target": "ESNext",
        "moduleDetection": "force",
        "typeRoots": [
            "node_modules/@rbxts"
        ],
        // configurable
        "rootDir": "src",
        "rootDirs": [
            "src",
            "src/examples"
        ],
        "outDir": "out",
        "declaration": true
    },
    "include": [
        "src",
    ],
    "exclude": [
        "**/node_modules",
        "src/examples",
    ]
}